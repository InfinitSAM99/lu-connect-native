{
  "expo": {
    "name": "LU Connect",
    "slug": "lu-connect-native",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "luconnectnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.infinitsam.luconnectnative",
      "softwareKeyboardLayoutMode": "resize",
      "newArchEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "NOTIFICATIONS",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "INTERNET",
        "BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-video",
      "expo-sharing",
      "expo-notifications",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.av.** { *; }"
          }
        }
      ],
      "expo-asset",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "LU Connect needs access to your camera for appeals and posts."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "LU Connect needs access to your library to save reels and media.",
          "savePhotosPermission": "LU Connect needs permission to save photos and videos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "LU Connect uses your location to show nearby events and friends."
        }
      ],
      [
        "expo-linking",
        {
          "scheme": "luconnect"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0c999e89-770d-4e66-b002-bf398b0a3b87"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0c999e89-770d-4e66-b002-bf398b0a3b87"
    },
    "newArchEnabled": false
  }
}