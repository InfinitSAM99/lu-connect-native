{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "dist",
    "build",
    "web-build",
    ".expo",
    "node_modules",
    "android",
    "ios",
    "backup_nov13",
    "supabase/functions",
    "push-test",
    "scripts"
  ]
}
